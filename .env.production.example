# Variáveis de build do front-end (Vite). Copie para .env.production e ajuste.
# A chave é a publishable/anon do Supabase. NUNCA use service-role/secret aqui:
# tudo que entra em VITE_* vai para o bundle público.
VITE_SUPABASE_URL=https://supabase.nutef.com
VITE_SUPABASE_ANON_KEY=<chave-publishable-anon-da-stack>
